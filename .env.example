# Copy to `.env` and edit:  cp .env.example .env
# Precedence: real env vars / CLI  >  .env  >  built-in defaults. Only uncomment what you want to change.

# ---- target ----
# TWITCH_BASE_URL=https://www.twitch.tv
# TWITCH_SEARCH_TERM=StarCraft II

# ---- browser ----
# TWITCH_DEVICE=Pixel 7              # any Chrome DevTools emulated device name
# TWITCH_HEADLESS=false              # true for CI / servers without a display
# TWITCH_TIMEOUT=15                  # element wait timeout in seconds
# TWITCH_LIGHT_MODE=true             # no autoplay, muted, reduced motion, no GPU (faster on heavy pages)
# TWITCH_BLOCK_IMAGES=false          # true = faster, but screenshots have no images
# TWITCH_NO_SANDBOX=false            # true inside Docker (Chrome running as root needs it)
# TWITCH_CHROME_ARGS=                # extra Chrome flags, whitespace separated, e.g. --disable-quic --no-proxy-server
# CHROME_BIN=                        # custom Chrome/Chromium binary (set in the Docker image)
# CHROMEDRIVER_PATH=                 # custom chromedriver (set in the Docker image)

# ---- test run ----
# TWITCH_TAGS=                       # pytest -m expression, e.g. smoke | "smoke and not slow" (CLI -m wins)
# TWITCH_SCREENSHOT_POLICY=on-failure   # off | on-failure | always
# TWITCH_VIDEO_POLICY=on-failure        # off | on-failure | always
# TWITCH_SKIP_UNIT_GATE=false        # true = run specs even if unit tests fail (not recommended)

# ---- output ----
# TWITCH_HTML_REPORT=reports/report-{stage}.html   # {stage} -> unit / e2e / all, so reports never overwrite each other. Empty = off
# TWITCH_JUNIT_XML=                                # JUnit XML for CI, e.g. reports/junit-{stage}.xml. Empty = off
# TWITCH_SCREENSHOT_DIR=reports/screenshots
# TWITCH_VIDEO_DIR=reports/videos
